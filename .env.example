# Copy to .env.local and fill in. Never commit real secrets.

# --- Public (exposed to the browser) ---------------------------------------
NEXT_PUBLIC_SITE_URL=https://indymustardseed.online
# Demo mode labels seed data and blocks indexing. Set to "false" only after the
# demo catalog has been replaced with real supplier products.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_PINTEREST=

# --- Catalog ----------------------------------------------------------------
# "seed" = development demo data in src/data/seed. Add "database" etc. in
# src/server/catalog/repository.ts when a real source exists.
CATALOG_SOURCE=seed
DATABASE_URL=
# Example supplier feed (see src/server/suppliers/registry.ts)
DEMO_GROW_FEED_URL=

# --- Admin API (Bearer token, min 24 chars; unset = admin API disabled) ------
ADMIN_API_TOKEN=

# --- Payments (a method is shown only when configured) -----------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Apple Pay / Google Pay via Stripe after domain verification
STRIPE_WALLETS_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Customer accounts -------------------------------------------------------
AUTH_PROVIDER=

# --- Email / newsletter ------------------------------------------------------
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=
